# Copy to .env (never commit .env). Config files only reference these variable NAMES.
# Kalshi API credentials (required for Kalshi WebSocket market data; REST polling works without)
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY=
KALSHI_PRIVATE_KEY_PATH=
# Recommended for CI / small linear algebra workloads
OPENBLAS_NUM_THREADS=1
